# Mocked AWS provider: no test contacts AWS. The fixture is generated by the API's
# AwsIamOnboardingBundleBuilder (see tests/fixtures in the repo root).

mock_provider "aws" {
  mock_data "aws_caller_identity" {
    defaults = {
      account_id = "111122223333"
      arn        = "arn:aws:sts::111122223333:assumed-role/Administrator/terraform"
      user_id    = "AROAEXAMPLE:terraform"
    }
  }

  mock_data "aws_partition" {
    defaults = {
      partition          = "aws"
      dns_suffix         = "amazonaws.com"
      reverse_dns_prefix = "com.amazonaws"
    }
  }

  mock_resource "aws_iam_role" {
    defaults = {
      arn       = "arn:aws:iam::111122223333:role/SpottoReadOnlyRole"
      unique_id = "AROAEXAMPLEROLEID0001"
    }
  }
}

variables {
  setup_package = file("../../tests/fixtures/spotto-aws-setup.json")
  account_id    = "111122223333"
}

run "current_api_role_uses_exact_inline_policies_without_managed_attachments" {
  command = apply

  variables {
    setup_package = file("../../tests/fixtures/spotto-aws-setup-current.json")
  }

  assert {
    condition     = jsondecode(aws_iam_role.spotto.assume_role_policy) == jsondecode(var.setup_package).roles[0].setup.onboardingBundle.trustPolicy
    error_message = "The current API company trust is applied unchanged."
  }

  assert {
    condition = (
      keys(aws_iam_role_policy.spotto) == ["SpottoBillingExportRead", "SpottoCommitmentsPlanning", "SpottoGuardrails"] &&
      jsondecode(aws_iam_role_policy.spotto["SpottoBillingExportRead"].policy) == jsondecode(var.setup_package).roles[0].setup.onboardingBundle.billingAccessPolicy &&
      jsondecode(aws_iam_role_policy.spotto["SpottoCommitmentsPlanning"].policy) == jsondecode(var.setup_package).roles[0].setup.onboardingBundle.commitmentsAccessPolicy &&
      jsondecode(aws_iam_role_policy.spotto["SpottoGuardrails"].policy) == jsondecode(var.setup_package).roles[0].setup.onboardingBundle.guardrailPolicy
    )
    error_message = "Current API discovery, billing and commitments policies are applied unchanged."
  }

  assert {
    condition     = length(aws_iam_role_policy_attachment.managed) == 0 && length(output.managed_policy_arns) == 0
    error_message = "The current package creates no AWS managed policy attachments."
  }
}

run "management_account_gets_definition_and_commitments_policies" {
  command = apply

  assert {
    condition     = aws_iam_role.spotto.name == "SpottoReadOnlyRole"
    error_message = "The standard Spotto role name is used."
  }

  assert {
    condition     = jsondecode(aws_iam_role.spotto.assume_role_policy) == jsondecode(var.setup_package).roles[0].setup.onboardingBundle.trustPolicy
    error_message = "The trust policy is the API-authored company trust, unchanged."
  }

  assert {
    condition     = keys(aws_iam_role_policy.spotto) == ["SpottoBillingExportRead", "SpottoCommitmentsPlanning", "SpottoGuardrails"]
    error_message = "The management account receives guardrail, billing-definition and commitments policies."
  }

  assert {
    condition = (
      jsondecode(aws_iam_role_policy.spotto["SpottoBillingExportRead"].policy) == jsondecode(var.setup_package).roles[0].setup.onboardingBundle.billingAccessPolicy &&
      jsondecode(aws_iam_role_policy.spotto["SpottoCommitmentsPlanning"].policy) == jsondecode(var.setup_package).roles[0].setup.onboardingBundle.commitmentsAccessPolicy &&
      jsondecode(aws_iam_role_policy.spotto["SpottoGuardrails"].policy) == jsondecode(var.setup_package).roles[0].setup.onboardingBundle.guardrailPolicy
    )
    error_message = "Inline policies are the API-authored documents, unchanged."
  }

  assert {
    condition     = toset(keys(aws_iam_role_policy_attachment.managed)) == toset(["arn:aws:iam::aws:policy/ReadOnlyAccess", "arn:aws:iam::aws:policy/SecurityAudit"])
    error_message = "Discovery attaches SecurityAudit and ReadOnlyAccess."
  }

  assert {
    condition     = aws_iam_role.spotto.tags["SpottoManagedBy"] == "Terraform" && aws_iam_role.spotto.tags["SpottoCompanyId"] == "company-example"
    error_message = "Ownership tags tell the PowerShell wizard that Terraform owns the role."
  }

  assert {
    condition     = aws_iam_role.spotto.permissions_boundary == null
    error_message = "No permissions boundary is set unless requested."
  }

  assert {
    condition = output.handoff_result == {
      accountId = "111122223333"
      roleArn   = "arn:aws:iam::111122223333:role/SpottoReadOnlyRole"
      status    = "configured"
    }
    error_message = "The account handoff result reports configured IAM setup."
  }
}

run "separate_storage_account_gets_only_storage_scopes" {
  command = plan

  variables {
    account_id = "000011112222"
  }

  override_data {
    target = data.aws_caller_identity.current
    values = {
      account_id = "000011112222"
    }
  }

  assert {
    condition     = keys(aws_iam_role_policy.spotto) == ["SpottoBillingExportRead", "SpottoGuardrails"]
    error_message = "The storage account receives no commitments policy."
  }

  assert {
    condition = (
      strcontains(aws_iam_role_policy.spotto["SpottoBillingExportRead"].policy, "arn:aws:s3:::example-cost-exports/cur2/example-cur2/*") &&
      strcontains(aws_iam_role_policy.spotto["SpottoBillingExportRead"].policy, "kms:Decrypt") &&
      !strcontains(aws_iam_role_policy.spotto["SpottoBillingExportRead"].policy, "bcm-data-exports")
    )
    error_message = "Storage access is scoped to the export delivery path and KMS key, without definition access."
  }

  assert {
    condition     = strcontains(aws_iam_role_policy.spotto["SpottoGuardrails"].policy, "DenyS3ObjectReadsOutsideBillingScopes")
    error_message = "The storage guardrail denies object reads outside the delivery path."
  }
}

run "workload_account_gets_discovery_only" {
  command = plan

  variables {
    account_id = "444455556666"
  }

  override_data {
    target = data.aws_caller_identity.current
    values = {
      account_id = "444455556666"
    }
  }

  assert {
    condition     = keys(aws_iam_role_policy.spotto) == ["SpottoGuardrails"]
    error_message = "A discovery-only account receives only the guardrail policy."
  }
}

run "customer_tags_and_boundary_cannot_override_ownership" {
  command = plan

  variables {
    permissions_boundary_arn = "arn:aws:iam::111122223333:policy/CustomerBoundary"
    tags = {
      CostCentre      = "platform"
      SpottoManagedBy = "Setup-SpottoAws"
    }
  }

  assert {
    condition = (
      aws_iam_role.spotto.tags["CostCentre"] == "platform" &&
      aws_iam_role.spotto.tags["SpottoManagedBy"] == "Terraform" &&
      aws_iam_role.spotto.permissions_boundary == "arn:aws:iam::111122223333:policy/CustomerBoundary"
    )
    error_message = "Customer tags and boundaries are applied, but ownership tags cannot be overridden."
  }
}

