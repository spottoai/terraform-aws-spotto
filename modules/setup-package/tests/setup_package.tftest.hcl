# Fixture generated by the API's AwsIamOnboardingBundleBuilder: an organization with a
# management/definition account, a separate KMS-encrypted billing storage account, a
# workload account and one disabled account.

variables {
  setup_package = file("../../tests/fixtures/spotto-aws-setup.json")
}

run "valid_package_exposes_only_enabled_accounts" {
  command = plan

  assert {
    condition     = output.account_ids == tolist(["000011112222", "111122223333", "444455556666"])
    error_message = "Only enabled accounts are covered, preserving leading zeros."
  }

  assert {
    condition     = output.company_id == "company-example"
    error_message = "The package company binding is exposed."
  }

  assert {
    condition = (
      keys(output.roles["111122223333"].inline_policies) == ["SpottoBillingExportRead", "SpottoCommitmentsPlanning", "SpottoGuardrails"] &&
      keys(output.roles["000011112222"].inline_policies) == ["SpottoBillingExportRead", "SpottoGuardrails"] &&
      keys(output.roles["444455556666"].inline_policies) == ["SpottoGuardrails"]
    )
    error_message = "Each account receives only the Spotto policies for its purposes."
  }

  assert {
    condition = alltrue([
      for role in jsondecode(var.setup_package).roles :
      jsondecode(output.roles[role.accountId].trust_policy_json) == role.setup.onboardingBundle.trustPolicy &&
      jsondecode(output.roles[role.accountId].inline_policies["SpottoGuardrails"]) == role.setup.onboardingBundle.guardrailPolicy
    ])
    error_message = "Trust and guardrail documents are passed through unchanged from the API."
  }

  assert {
    condition     = output.roles["444455556666"].managed_policy_arns == tolist(["arn:aws:iam::aws:policy/ReadOnlyAccess", "arn:aws:iam::aws:policy/SecurityAudit"])
    error_message = "Discovery uses only the allowlisted AWS managed policies."
  }

  assert {
    condition     = output.configuration == jsondecode(var.setup_package).configuration
    error_message = "The configuration is echoed unchanged for the portal handoff."
  }
}

run "rejects_non_json" {
  command = plan

  variables {
    setup_package = "not json"
  }

  expect_failures = [var.setup_package]
}

run "rejects_another_package_kind" {
  command = plan

  variables {
    setup_package = replace(file("../../tests/fixtures/spotto-aws-setup.json"), "\"kind\": \"spotto.aws.setup\"", "\"kind\": \"spotto.azure.setup\"")
  }

  expect_failures = [output.roles]
}

run "rejects_string_schema_versions" {
  command = plan

  variables {
    setup_package = replace(file("../../tests/fixtures/spotto-aws-setup.json"), "\"schemaVersion\": 1", "\"schemaVersion\": \"1\"")
  }

  expect_failures = [output.roles]
}

run "rejects_wildcard_trust" {
  command = plan

  variables {
    setup_package = replace(file("../../tests/fixtures/spotto-aws-setup.json"), "arn:aws:iam::999900001111:role/SpottoEngine", "*")
  }

  expect_failures = [output.roles]
}

