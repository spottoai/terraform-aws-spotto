}

run "rejects_purposes_not_backed_by_an_enabled_billing_source" {
  command = plan

  variables {
    # The management account keeps billing-definition in its role, but no source assigns it.
    setup_package = replace(file("../../tests/fixtures/spotto-aws-setup.json"), "\"definitionRoleAccountId\": \"111122223333\"", "\"definitionRoleAccountId\": \"444455556666\"")
  }

  expect_failures = [output.roles]
}
