}

run "rejects_unexpected_managed_policy" {
  command = plan

  variables {
    setup_package = replace(file("../../tests/fixtures/spotto-aws-setup.json"), "arn:aws:iam::aws:policy/SecurityAudit", "arn:aws:iam::aws:policy/AdministratorAccess")
